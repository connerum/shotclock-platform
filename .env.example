# Shotclock Platform Environment Configuration

# Database
DATABASE_URL="file:./dev.db"

# Server
NEXT_PUBLIC_SERVER_URL="http://localhost:3000"
SERVER_URL="http://localhost:3000"
SERVER_PORT="3000"
COREPACK_HOME="/opt/courtcast/shared/corepack"
COURTCAST_MEDIA_DIR="/opt/courtcast/shared/media"
AUTH_SECRET="replace-with-at-least-32-random-characters"
ALLOWED_ORIGINS="http://localhost:3000"
ALLOW_PUBLIC_REGISTRATION="false"

# Socket.IO
SOCKET_SERVER_URL="http://localhost:3000"

# Device Configuration
DEFAULT_DEVICE_NAME="Shotclock Display"
PAIRING_CODE_LENGTH="6"

# WiFi Configuration
SETUP_AP_SSID="Shotclock-Setup"
SETUP_AP_PASSWORD="replace-with-unique-device-password"
DEVICE_AUTH_TOKEN="replace-with-64-character-random-token"
SETUP_AP_CHANNEL="6"

# Update Configuration
UPDATE_CHECK_INTERVAL="3600000"
FIRMWARE_RELEASES_PATH="/opt/shotclock/releases"

# Agent Configuration
AGENT_LOCAL_API_PORT="3001"
AGENT_LOCAL_API_HOST="127.0.0.1"
AGENT_HEARTBEAT_INTERVAL="30000"
