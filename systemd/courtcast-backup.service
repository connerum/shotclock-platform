[Unit]
Description=CourtCast consistent application backup

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/courtcast-backup
User=root
Group=root
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/backups/courtcast /var/lib/courtcast/backup
